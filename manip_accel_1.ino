        if (count[m]) {
          periodTicks[j] = quickStopping[j] ? nextQuickInterval(j) :
              intervalForStep(j, moveSteps[j] - count[m] + 1UL);
          riseWait[j] = periodTicks[j] > late ? periodTicks[j] - late : 0;
        }
      }
    }
    if (count[m] || pulseHigh[j]) any = true;
  }
  if (timingFault) {
    any = false;
    for (byte j = 0; j < NJ; j++) if (pulseHigh[j]) any = true;
  }
  if (!any) {
    TIMSK1 &= ~_BV(OCIE1A);
    moving = false;
    motionFinished = true;
  } else armNextInterrupt();
}

// Initialize Timer1 without changing the existing pin wiring.
void setupMotionTimer() {
  ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {
    TCCR1A = 0;
    TCCR1B = _BV(CS11);
    TIMSK1 = 0;
    TCNT1 = 0;
    TIFR1 = _BV(OCF1A);
  }
}

double pulsesPerDegree(byte m) {
  return PULSES_PER_REV[m] * GEAR[JOINT[m]] / 360.0;
}

double angle(byte j) {
  byte m = PRIMARY[j];
  // Copy the 32-bit counter atomically on the 8-bit AVR.
  long snapshot;
  ATOMIC_BLOCK(ATOMIC_RESTORESTATE) { snapshot = position[m]; }
  return (double)snapshot / pulsesPerDegree(m);
}

long rounded(double x) {
  return (long)(x >= 0 ? floor(x + 0.5) : ceil(x - 0.5));
}

char *spaces(char *p) {
  while (isspace((unsigned char)*p)) p++;
  return p;
}

bool number(char *p, double &value) {
  p = spaces(p);
  char *end;
  value = strtod(p, &end);

  return end != p &&
         isfinite(value) &&
         *spaces(end) == '\0';
}

// Accepts: 0,20,-15,30,10
// Also:   0 , 20 , -15 , 30 , 10
bool fiveAngles(char *p, double values[NJ]) {
  for (byte j = 0; j < NJ; j++) {
    p = spaces(p);

    char *end;
    values[j] = strtod(p, &end);

    if (end == p || !isfinite(values[j])) return false;

    end = spaces(end);

    if (j < NJ - 1) {
      if (*end != ',') return false;
      p = end + 1;
    } else {
      if (*end != '\0') return false;
    }
  }

  return true;
}

// -1 = ALL, -2 = invalid, 0..4 = joint.
int scope(char *p) {
  p = spaces(p);

  if (*p == '\0') return -1;

  if (strncmp(p, "ALL", 3) == 0 &&
      *spaces(p + 3) == '\0') {
    return -1;
  }

  double value;
  if (!number(p, value) ||
      value < 1 || value > NJ ||
      floor(value) != value) {
    return -2;
  }

  return (int)value - 1;
}

// S requests a nonblocking quick ramp. Y disables immediately,
// cancels pending steps, and clears home; it never waits for a braking ramp.
void stopMotors(int joint, bool disable) {
  ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {
    for (byte j = 0; j < NJ; j++) {
      if (joint >= 0 && j != joint) continue;
      if (disable) {
        for (byte m = 0; m < NM; m++) if (JOINT[m] == j) {
          digitalWrite(EN_PIN[m], DISABLE);
          count[m] = 0;
        }
        stepLevel(j, false);
        pulseHigh[j] = false;
        quickStopping[j] = false;
        stopRequest &= ~_BV(j);
        homed[j] = false;
      } else if (count[PRIMARY[j]] && !quickStopping[j]) stopRequest |= _BV(j);
    }
    bool any = false;
    for (byte j = 0; j < NJ; j++) if (count[PRIMARY[j]] || pulseHigh[j]) any = true;
    moving = any;
    if (!any) { TIMSK1 &= ~_BV(OCIE1A); motionFinished = false; }
    else if (stopRequest) {
      // Service S promptly even during a slow, long pulse interval.
      OCR1A = TCNT1 + 64U;
      TIFR1 = _BV(OCF1A);
      TIMSK1 |= _BV(OCIE1A);
    }
  }
}

bool validSpeed(byte j, double value) {
  byte m = PRIMARY[j];
  double hz = value * pulsesPerDegree(m);
  // Compare in degrees/sec to avoid rejecting the exact limit because
  // pulsesPerDegree() is rounded on the Mega's 32-bit floating point.
  double maximumDps = MAX_STEP_HZ * 360.0 /
                      (PULSES_PER_REV[m] * GEAR[j]);
  
  // Limit joint speed as well as the driver pulse rate.
  if (maximumDps > MAX_JOINT_DPS) maximumDps = MAX_JOINT_DPS;
  if (!isfinite(value) || value <= 0 || !isfinite(hz) ||
      value > maximumDps || hz < 1000000.0 / 2000000000.0) {
    Serial.print(F("Invalid speed for J"));
    Serial.print(j + 1);
    Serial.print(F("; maximum deg/s: "));
    Serial.println(maximumDps, 3);
    return false;
  }
  return true;
}

void setHome(int joint) {
  if (moving) {
    Serial.println(F("Stop before setting home."));
    return;
  }

  for (byte m = 0; m < NM; m++) {
    if (joint >= 0 && JOINT[m] != joint) continue;

    position[m] = 0;
    homed[JOINT[m]] = true;
    digitalWrite(EN_PIN[m], ENABLE);
  }

  delayMicroseconds(1000);
  Serial.println(F("Current position saved as zero/home."));
}

// All inputs here are ABSOLUTE JOINT angles.
// Gear ratios and driver pulse settings are applied per motor.
void moveTo(const double target[NJ], const bool active[NJ]) {
  if (!configOK) {
    Serial.println(F("Invalid configuration."));
    return;
  }

  if (moving) {
    Serial.println(F("Busy. Wait for Done or send S."));
    return;
  }

  long delta[NM] = {0};
  unsigned long largest = 0;
  unsigned long newPeriod[NJ] = {0};

  // Validate every selected joint before moving anything.
  for (byte j = 0; j < NJ; j++) {
    if (!active[j]) continue;

    if (!validSpeed(j, speedDps[j])) return;
    // Compute Hz before reciprocal to avoid rounding 500 us up to 501 us.
    double stepHz = (speedDps[j] * PULSES_PER_REV[PRIMARY[j]] * GEAR[j]) / 360.0;
    newPeriod[j] = (unsigned long)ceil(1000000.0 / stepHz);

    if (!homed[j]) {
      Serial.print(F("Set home first for J"));
      Serial.println(j + 1);
      return;
    }

    if (!isfinite(target[j])) {
      Serial.println(F("Invalid angle."));
      return;
    }

    // Half-pulse tolerance: angle() is quantised to whole pulses, so a relative
    // move from e.g. 80.01 deg by +10 must not be rejected for landing on 90.01.
    double tol = 0.5 / pulsesPerDegree(PRIMARY[j]);
    if (LIMITED[j] &&
        (target[j] < MIN_DEG[j] - tol || target[j] > MAX_DEG[j] + tol)) {
      Serial.print(F("Rejected: J"));
      Serial.print(j + 1);
      Serial.print(F(" range is "));
      Serial.print(MIN_DEG[j], 0);
      Serial.print(F(" to "));
      Serial.println(MAX_DEG[j], 0);
      return;
    }
  }

  for (byte m = 0; m < NM; m++) {
    byte j = JOINT[m];
    if (!active[j]) continue;

    double scale = pulsesPerDegree(m);
    double exact = target[j] * scale;

    if (!isfinite(exact) ||
        fabs(exact) > MAX_POSITION_PULSES) {
      Serial.println(F("Target exceeds counter range."));
      return;
    }

    long endpoint = rounded(exact);

    // Rounding must not put an endpoint outside its limit.
    if (LIMITED[j]) {
      long minimum = (long)ceil(MIN_DEG[j] * scale - 0.01);
      long maximum = (long)floor(MAX_DEG[j] * scale + 0.01);

      if (endpoint < minimum) endpoint = minimum;
      if (endpoint > maximum) endpoint = maximum;
    }

    long difference = endpoint - position[m];   // integer math, exact

    if (labs(difference) > MAX_MOVE_PULSES) {
      Serial.println(F("Move exceeds pulse limit."));
      return;
    }

    delta[m] = difference;

    unsigned long magnitude = (unsigned long)labs(delta[m]);
    if (magnitude > largest) largest = magnitude;
  }

  if (largest == 0) {
    Serial.println(F("Already at target."));
    positionReportPending = true;
    return;
  }

  // Prepare every normal profile before enabling any motor.
  if (!prepareRamps(delta)) return;
  stopRequest = 0;
  for (byte j = 0; j < NJ; j++) {
    quickStopping[j] = false;
    periodUs[j] = newPeriod[j];
    // Schedule acceleration from rest, including the first pulse.
    periodTicks[j] = moveSteps[j] ? intervalForStep(j, 1) : 0;
    riseWait[j] = periodTicks[j];
    lowWait[j] = 0;
    pulseHigh[j] = false;
  }

  for (byte m = 0; m < NM; m++) {
    count[m] = (unsigned long)labs(delta[m]);
    stepSign[m] = delta[m] >= 0 ? 1 : -1;

    digitalWrite(STEP_PIN[m], LOW);

    if (!count[m]) continue;

    bool direction = delta[m] > 0 ? POS_DIR[m] : !POS_DIR[m];
    digitalWrite(DIR_PIN[m], direction ? HIGH : LOW);
    digitalWrite(EN_PIN[m], ENABLE);
  }

  delayMicroseconds(1000);
  ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {
    motionFinished = false;
    timingFault = false;
    moving = true;
    timerReference = TCNT1;
    armNextInterrupt();
    TIFR1 = _BV(OCF1A);
    TIMSK1 |= _BV(OCIE1A);
  }
}

// Loop only reports completion; Timer1 generates the pulses.
void updateMotion() {
  bool finished;
  ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {
    finished = motionFinished;
    motionFinished = false;
  }
  if (finished) {
    if (timingFault) Serial.println(F("Timing overrun: motion stopped; check interrupt load."));
    else Serial.println(F("Done."));
    positionReportPending = true;
  }
}

void printPositions() {
  for (byte j = 0; j < NJ; j++) {
    Serial.print(F("J"));
    Serial.print(j + 1);
    Serial.print(F(": "));
    Serial.print(angle(j), 3);
    Serial.print(F(" degrees; home "));
    Serial.print(homed[j] ? F("SET") : F("UNSET"));
    Serial.print(F("; speed deg/s: "));
    Serial.println(speedDps[j], 3);
  }
}

void help() {
  Serial.println(F("115200 baud; Newline"));
  Serial.println(F("All joints default to 10 deg/s; maximum 22.5 deg/s."));
  // Clarify short moves and immediate disable behavior.
  Serial.println(F("Short moves use a lower peak speed. Confirmed D disables without a ramp."));
  Serial.println(F("F5 : set selected joint speed to 5 deg/s"));
  Serial.println(F("R5,10,3,20,8 : set J1..J5 speeds in deg/s"));
  Serial.println(F("Set speeds while stopped, then send G, A, M or B."));
  Serial.println(F("Speeds persist; normal accel/decel 0.5 s, quick stop up to 0.1 s."));
  Serial.println(F("H       : set ALL current positions as zero/home"));
  Serial.println(F("H2      : set J2 current position as zero/home"));
  Serial.println(F("M0,20,-15,30,10 : absolute angles for J1..J5"));
  Serial.println(F("Spaces around commas are allowed."));
  Serial.println(F("M0,0,0,0,0 : return ALL joints to zero/home"));
  Serial.println(F("B / B2  : return ALL / J2 home"));
  Serial.println(F("J2      : select J2; selection supports J1..J5"));
  Serial.println(F("A10     : selected joint +10 relative degrees"));
  Serial.println(F("A-10    : selected joint -10 relative degrees"));
  Serial.println(F("G30     : selected joint to absolute 30 degrees"));
  Serial.println(F("S / S2  : quick ramp stop ALL / J2; retain holding"));
  Serial.println(F("D / D2  : request disable ALL / J2; confirm Y or cancel N"));
  Serial.println(F("Pending D: movement continues; S stops and cancels the request."));
  Serial.println(F("Positions print automatically when all movement stops."));
  Serial.println(F("V       : positions"));
  Serial.println(F("?       : help"));
}

void command(char *p) {
  p = spaces(p);
  if (!*p) return;

  for (char *q = p; *q; q++) {
    *q = toupper((unsigned char)*q);
  }

  char action = *p;
  char *args = spaces(p + 1);

  // Confirmation uses a complete line, just like the other commands.
  if (pendingDisable != -2 && action != 'S') {
    if (*args || (action != 'Y' && action != 'N')) {
      Serial.println(F("Disable pending: enter Y or N; S remains available."));
      return;
    }
    int joint = pendingDisable;
    pendingDisable = -2;
    if (action == 'N') {
      Serial.println(F("Disable cancelled."));
      return;
    }
    stopMotors(joint, true);
    Serial.println(F("Disabled immediately; set home again before moving."));
    positionReportPending = true;
    return;
  }
  if (action == 'Y' || action == 'N') {
    Serial.println(F("No disable confirmation pending."));
    return;
  }

  if (action == 'S' || action == 'D' ||
      action == 'H' || action == 'B') {
    int joint = scope(args);

    if (joint == -2) {
      Serial.println(F("Use joint 1..5, ALL, or no argument."));
      return;
    }

    if (action == 'D') {
      pendingDisable = joint;
      Serial.print(F("Disable "));
      if (joint < 0) Serial.print(F("ALL joints"));
      else {
        Serial.print(F("J"));
        Serial.print(joint + 1);
      }
      Serial.println(F("? Holding torque will be removed. Y/N"));
      return;
    }
    if (action == 'S') {
      if (pendingDisable != -2) {
        pendingDisable = -2;
        Serial.println(F("Disable cancelled."));
      }
      stopMotors(joint, false);
      // S returns while the selected joints are still braking.
      Serial.println(F("Quick stop requested; wait for Done."));
      positionReportPending = true;
      return;
    }

    if (action == 'H') {
      setHome(joint);
      return;
    }

    double target[NJ] = {0};
    bool active[NJ] = {false};

    for (byte j = 0; j < NJ; j++) {
      active[j] = joint < 0 || j == joint;
    }

    moveTo(target, active);
    return;
  }

  if (moving) {
    Serial.println(F("Busy. Wait for Done or send S."));
    return;
  }

  if (action == 'F') {
    double value;
    if (!number(args, value)) {
      Serial.println(F("Format: F5 (positive degrees/second)"));
      return;
    }
    if (!validSpeed(selected, value)) return;
    speedDps[selected] = value;
    Serial.println(F("Speed saved."));
    return;
  }

  if (action == 'R') {
    double values[NJ];
    if (!fiveAngles(args, values)) {
      Serial.println(F("Format: R5,10,3,20,8 (degrees/second)"));
      return;
    }
    for (byte j = 0; j < NJ; j++) {
      if (!validSpeed(j, values[j])) return;
    }
    for (byte j = 0; j < NJ; j++) speedDps[j] = values[j];
    Serial.println(F("Speeds saved."));
    return;
  }

  if (action == 'M') {
    double target[NJ];
    bool active[NJ] = {true, true, true, true, true};

    if (!fiveAngles(args, target)) {
      Serial.println(F("Format: M0 , 20 , -15 , 30 , 10"));
      return;
    }

    moveTo(target, active);
    return;
  }

  if (action == 'J') {
    int joint = scope(args);

    if (joint < 0) {
      Serial.println(F("Use J1 through J5."));
      return;
    }

    selected = (byte)joint;
    Serial.print(F("Selected J"));
    Serial.println(selected + 1);
    return;
  }

  if (action == 'A' || action == 'G') {
    double value;

    if (!number(args, value)) {
      Serial.println(F("Invalid angle."));
      return;
    }

    double target[NJ] = {0};
    bool active[NJ] = {false};

    active[selected] = true;
    target[selected] = action == 'A'
      ? angle(selected) + value
      : value;

    moveTo(target, active);
    return;
  }

  if (*args) {
    Serial.println(F("Unexpected arguments."));
    return;
  }

  if (action == 'V') printPositions();
  else if (action == '?') help();
  else Serial.println(F("Unknown command. Send ?."));
}

void readSerial() {
  byte budget = 16;

  while (budget-- && Serial.available()) {
    updateMotion();

    char c = (char)Serial.read();

    if (c == '\r' || c == '\n') {
      if (overflowed) {
        Serial.println(F("Command too long; discarded."));
      } else if (bufferLength) {
        buffer[bufferLength] = '\0';
        command(buffer);
      }

      bufferLength = 0;
      overflowed = false;
    } else if (!overflowed) {
      if (bufferLength < sizeof(buffer) - 1) {
        buffer[bufferLength++] = c;
      } else {
        overflowed = true;
      }
    }
  }
}

void setup() {
  Serial.begin(115200);

  for (byte m = 0; m < NM; m++) {
    digitalWrite(EN_PIN[m], DISABLE);
    pinMode(EN_PIN[m], OUTPUT);

    digitalWrite(STEP_PIN[m], LOW);
    pinMode(STEP_PIN[m], OUTPUT);

    digitalWrite(DIR_PIN[m], LOW);
    pinMode(DIR_PIN[m], OUTPUT);
  }

  // Reserve Timer1 for the motion scheduler.
  setupMotionTimer();
  configOK = true;

  for (byte m = 0; m < NM; m++) {
    double scale = pulsesPerDegree(m);

    if (!isfinite(scale) || scale <= 0 ||
        PULSES_PER_REV[m] <= 0 || GEAR[JOINT[m]] <= 0) {
      configOK = false;
    }
  }

  for (byte m = 0; m < NM; m++) {
    if (fabs(pulsesPerDegree(m) -
             pulsesPerDegree(PRIMARY[JOINT[m]])) > 0.00001) configOK = false;
  }

  help();
  Serial.println(F("Place arm at physical zero, then send H."));

  if (!configOK) {
    Serial.println(F("ERROR: Invalid motor configuration."));
  }
}

void loop() {
  updateMotion();
  readSerial();
  // Report final positions once all timer-controlled motion stops.
  if (positionReportPending && !moving) {
    positionReportPending = false;
    printPositions();
  }
}