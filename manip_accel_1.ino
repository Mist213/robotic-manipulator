// Profile planner forward declaration.
double pulsesPerDegree(byte m);
// Precompute only the ramp intervals while stopped. The ISR
// mirrors them for deceleration, using integer lookups and no square roots.
// 1100 entries cover all five joints at 22.5 deg/s with the configured gearing.
const uint16_t RAMP_CAPACITY = 1100;
uint32_t rampTicks[RAMP_CAPACITY];
uint16_t rampOffset[NJ] = {0};
uint16_t rampLength[NJ] = {0};
uint32_t moveSteps[NJ] = {0};
uint32_t cruiseTicks[NJ] = {0};

uint32_t intervalForStep(byte j, uint32_t k) {
  uint32_t mirror = moveSteps[j] + 1UL - k;
  uint32_t index = k < mirror ? k : mirror;
  if (index <= rampLength[j]) return rampTicks[rampOffset[j] + index - 1UL];
  return cruiseTicks[j];
}

// Exact constant-acceleration crossing times in step space.
// Short moves use a triangular profile; long moves include a cruise segment.
// Rounding uses the actual whole-step endpoint, so no steps are added/lost.
bool prepareRamps(const long delta[NM]) {
  uint16_t used = 0;
  for (byte j = 0; j < NJ; j++) {
    uint32_t n = (uint32_t)labs(delta[PRIMARY[j]]);
    moveSteps[j] = n;
    rampLength[j] = 0;
    if (!n) continue;
    double scale = pulsesPerDegree(PRIMARY[j]);
    double accel = speedDps[j] * scale / RAMP_SECONDS;
    double velocity = (speedDps[j] * PULSES_PER_REV[PRIMARY[j]] * GEAR[j]) / 360.0;
    double accelSteps = velocity * velocity / (2.0 * accel);
    if (accelSteps > n / 2.0) accelSteps = n / 2.0;
    double peak = sqrt(2.0 * accel * accelSteps);
    double rampTime = peak / accel;
    double totalTime = 2.0 * rampTime + (n - 2.0 * accelSteps) / velocity;
    uint16_t length = (uint16_t)ceil(accelSteps);
    if ((uint32_t)used + length > RAMP_CAPACITY) {
      Serial.println(F("Ramp buffer exceeded; check acceleration/gearing."));
      return false;
    }
    rampOffset[j] = used;
    rampLength[j] = length;
    cruiseTicks[j] = (uint32_t)ceil(2000000.0 / velocity);
    double previous = 0;
    for (uint16_t k = 1; k <= length; k++) {
      double time;
      if (2UL * k > n) {
        // The middle interval of an odd triangular move spans
        // the acceleration/deceleration transition and must not be doubled.
        time = totalTime - previous;
      } else if (k <= accelSteps) time = sqrt(2.0 * k / accel);
      else time = rampTime + (k - accelSteps) / velocity;
      double ticks = ceil((time - previous) * 2000000.0);
      if (!isfinite(ticks) || ticks < 80.0 || ticks > 4000000000.0) {
        Serial.println(F("Ramp interval out of range."));
        return false;
      }
      rampTicks[used++] = (uint32_t)ticks;
      previous = time;
    }
  }
  return true;
}

